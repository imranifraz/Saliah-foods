# Backend API (must match Backend PORT)
# Dev: leave empty (Vite proxy). Production: full API URL
VITE_API_URL=
VITE_SALIAH_GST_NUMBER=

# Set true to skip /api/categories and /api/products (static catalog fallback only)
# VITE_FORCE_STATIC_CATALOG=true

# Google Sign-In — https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Maps (Contact page) — https://developers.google.com/maps/documentation/embed/get-api-key
# Option A: Maps Embed API key (place search by address)
# VITE_GOOGLE_MAPS_EMBED_API_KEY=your-maps-embed-api-key
# Option B: paste full iframe src from Google Maps → Share → Embed a map
# VITE_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# Facebook Login — https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=your-facebook-app-id
